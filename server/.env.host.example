# Copy to .env.host on the box, next to .env, and fill in. Only the sim host sees this file. Never
# commit the real one.

# The admin password: without it nobody can start, pause or restart anything. It must be at least
# 24 characters. openssl rand -hex 24
LILGUY_ADMIN_PASSWORD=

# Sends the host's runs to Postgres on this box. Must match the host: entry in LILGUY_INGEST_TOKENS in
# .env. Without it, runs stay only in the host's own volume, which the nightly backup doesn't cover.
LILGUY_SYNC_TOKEN=

# Carries on from the latest morning checkpoint when the host restarts. A first start begins fresh.
LILGUY_RESUME=latest

# Who decides, by name from config/endpoints.yaml (deploy copies it into the image). Leave these out
# for the scripted policy, which calls no model and costs nothing.
# LILGUY_ENDPOINT=typesafe
# LILGUY_MEMORY_ENDPOINT=
# LILGUY_WRITER_ENDPOINT=
# LILGUY_RECALL_ENDPOINT=
# The key for each endpoint you name, under the name its api_key_env gives.
# TYPESAFE_API_KEY=

# How many game days a run lasts before it ends. 0 for no end.
# LILGUY_DAYS=0

# Start the first run without waiting for you to press start. A model costs money from then on.
# LILGUY_AUTOSTART=1
