# Copy to server/.env on the box and fill in. Never commit the real one. The sim host's own settings
# (the admin password, models) are in .env.host.example.
# With no domain of your own, sslip.io names work: lilguy.<ip with dashes>.sslip.io resolves to that IP.
DOMAIN=lilguy.example.com
# Where people watch the sim host. Needs its own DNS A record at the same IP as DOMAIN.
HOST_DOMAIN=live.lilguy.example.com
# openssl rand -hex 24
POSTGRES_PASSWORD=
# One token per writer, name:token, comma-separated. Each gets its own as LILGUY_SYNC_TOKEN (Mac:
# ~/.config/lil-guy-machine/secrets.env; TV: make tv-push-config; sim host: .env.host).
LILGUY_INGEST_TOKENS=mac:,tv:,host:
BACKUP_BUCKET=
