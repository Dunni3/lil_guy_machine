# Copy to server/.env on the box and fill in. Never commit the real one.
DOMAIN=lilguy.example.com
ACME_EMAIL=you@example.com
# openssl rand -hex 24
POSTGRES_PASSWORD=
# One token per writer, name:token, comma-separated. The Mac and the TV get theirs as
# LILGUY_SYNC_TOKEN (Mac: ~/.config/lil-guy-machine/secrets.env; TV: make tv-push-config).
LILGUY_INGEST_TOKENS=mac:,tv:
BACKUP_BUCKET=

# The sim host, when it joins this stack (host/README.md). Its own OAuth app, with the callback
# https://$DOMAIN/auth/callback. All four or none; none means nobody can send commands.
LILGUY_PUBLIC_URL=https://lilguy.example.com
LILGUY_GITHUB_CLIENT_ID=
LILGUY_GITHUB_CLIENT_SECRET=
# The admin's numeric GitHub user id (api.github.com/users/<login>), not the login.
LILGUY_ADMIN_GITHUB_ID=
# Signs the session cookie. openssl rand -hex 32; a new one signs everyone out.
LILGUY_SESSION_KEY=
# LILGUY_ADMIN_TOKEN is dev only: leave it out here.
