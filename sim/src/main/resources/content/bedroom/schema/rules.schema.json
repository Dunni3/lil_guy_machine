              "activity",
              "after_hours",
              "mood_per_hour",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "stimulation_per_hour": {
          "type": "number"
        },
        "bored": {
          "type": "number"
        },
        "bored_mood": {
          "type": "number"
        }
      },
      "required": [
        "awake_energy_per_hour",
        "fullness_per_hour",
        "mood_drift_per_hour",
