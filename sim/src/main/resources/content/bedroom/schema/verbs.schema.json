{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "lil guy machine: bedroom content, verbs.yaml",
  "description": "Generated by `make content-docs` from the content classes (sim/.../BedroomContent.kt, Ops.kt); don't edit.",
  "type": "object",
  "properties": {
    "verbs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "description": "What sort of verb it is: a contract on which ops `effects` may use.",
            "enum": [
              "consumptive",
              "generative",
              "transformative",
              "expressive",
              "economic",
              "rest"
            ]
          },
          "args": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "what",
                "on"
              ]
            },
            "additionalProperties": {
              "type": "string"
            },
            "description": "Argument slots (what, on), each filled by an owned item answering to this id or affordance. Ops and `at` can name a slot."
          },
          "at": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Where it happens: owned slot items by id (the nearest is used), an argument naming one, or `here`."
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Items or affordances he must own."
          },
          "minutes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "until": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "time": {
                    "type": "string"
                  },
                  "need": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reaches": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "time"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "work": {
            "type": "boolean",
            "description": "Work: refused below the work floor (rules.yaml)."
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "One op: a map with a single key, such as `- need: { mood: 2 }`.",
              "properties": {
                "need": {
                  "anyOf": [
                    {
                      "type": "object",
                      "propertyNames": {
                        "enum": [
                          "energy",
                          "fullness",
                          "mood",
                          "stimulation"
                        ]
                      },
                      "additionalProperties": {
                        "type": "number"
                      },
                      "description": "Changes needs. Gains in mood and stimulation are scaled by freshness (habituation). (at the finish)"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "rate": {
                  "anyOf": [
                    {
                      "type": "object",
                      "propertyNames": {
                        "enum": [
                          "energy",
                          "fullness",
                          "mood",
                          "stimulation"
                        ]
                      },
                      "additionalProperties": {
                        "type": "number"
                      },
                      "description": "Changes needs per game hour while the verb runs, scaled the same way. An `until` on a need needs a rate for it. (each minute)"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "consume": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer"
                      },
                      "description": "Uses up items, by id or affordance; locked while he has too few. (at the finish)"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "produce": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer"
                      },
                      "description": "Makes items. A drawable item made this way is drawn by the drawing model. (at the finish)"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sell": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Sells everything carried that answers to the name, at each item's `sellable` price, plus any commission reward. (at the finish)"
                },
                "set_state": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "target": {
                          "type": "string"
                        },
                        "state": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "target",
                        "state"
                      ],
                      "additionalProperties": false,
                      "description": "Puts his newest held piece answering to the target into a state. The one state is `hung`: on the picture rail, adding the gallery's comfort. (at the finish)"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "background": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "minutes": {
                          "type": "integer"
                        },
                        "rates": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "number"
                          }
                        }
                      },
                      "required": [
                        "name",
                        "minutes",
                        "rates"
                      ],
                      "additionalProperties": false,
                      "description": "Starts something that keeps going while he does anything else, playing the item bound to `what`. (at the finish, then each minute)"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sleep": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": false,
                      "description": "He's asleep: no awake drain of energy or stimulation. (while it runs)"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "enjoy": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Pays the bound item's value to him (qualities times affinities) as mood, scaled by freshness. (at the finish)",
                  "enum": [
                    "what",
                    "on",
                    null
                  ]
                }
              },
              "minProperties": 1,
              "maxProperties": 1,
              "additionalProperties": false
            },
            "description": "What it does: ops, run in order."
          },
          "block": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "need": {
                  "type": "string",
                  "enum": [
                    "energy",
                    "fullness",
                    "mood",
                    "stimulation"
                  ]
                },
                "below": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "above": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "need",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "stop_below": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "energy",
                "fullness",
                "mood",
                "stimulation"
              ]
            },
            "additionalProperties": {
              "type": "number"
            }
          },
          "tier": {
            "type": "integer",
            "description": "Above 0, gated until its id is granted."
          },
          "phrase": {
            "type": [
              "string",
              "null"
            ],
            "description": "How the prompt says what he can do; the id when left out."
          },
          "routine": {
            "type": "boolean",
            "description": "Upkeep: it neither wears thin nor counts as new."
          }
        },
        "required": [
          "id",
          "kind",
          "at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "verbs"
  ],
  "additionalProperties": false
}
