{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "lil guy machine: bedroom content, items.yaml",
  "description": "Generated by `make content-docs` from the content classes (sim/.../BedroomContent.kt, Ops.kt); don't edit.",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "group": {
            "type": "string",
            "description": "For display and grouping: fixture, furniture, decor, tool, food, supply, record, book, art."
          },
          "slot": {
            "type": [
              "string",
              "null"
            ],
            "description": "Placed in this room slot when owned."
          },
          "blocks": {
            "type": "boolean",
            "description": "He stands beside it, not on it."
          },
          "price": {
            "type": [
              "integer",
              "null"
            ]
          },
          "pack": {
            "type": "integer"
          },
          "stackable": {
            "type": "boolean"
          },
          "affords": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "readable",
                "playable",
                "edible",
                "sellable",
                "hangable",
                "viewable",
                "combinable",
                "wearable",
                "drawable",
                "staple"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "price": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "size": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "colors": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "strokes": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "skill": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "price_per_level": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "strokes_per_level": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "max_strokes": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            },
            "description": "Affordances from vocabulary.yaml, each with its parameters (`{}` for none)."
          },
          "qualities": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "cozy",
                "calm",
                "warm",
                "soft",
                "bright",
                "pretty",
                "natural",
                "lively",
                "strange",
                "loud"
              ]
            },
            "additionalProperties": {
              "type": "number"
            },
            "description": "Qualities from vocabulary.yaml, each with a strength above 0 and at most 3."
          },
          "carried": {
            "type": "boolean",
            "description": "Carried in his hands (art) rather than kept in the room."
          },
          "tier": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "group"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
